{
  "name": "bookshop",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build:entities && cds watch",
    "build:entities": "cds-typer '*' --outputDirectory ./@cds-models --logLevel SILENT",
    "build:entities:test": "npm run build:entities && npm run clean:js",
    "clean:js": "npx rimraf ./@cds-models/{*.js,**/*.js,**/**/*.js,**/**/**/*.js}"
  },
  "dependencies": {
    "@cap-js-community/websocket": "^1.11.0",
    "@dxfrontier/cds-ts-dispatcher": "^5",
    "@sap/cds": "^10",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.36.0",
    "@cap-js/cds-types": "^0.18",
    "@cap-js/sqlite": "^3",
    "@types/node": "^22.16.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js",
    "#dispatcher": "./@dispatcher/index.js"
  },
  "cds": {
    "requires": {
      "messaging": {
        "kind": "local-messaging"
      },
      "db": {
        "kind": "sql"
      },
      "auth": {
        "kind": "basic",
        "users": {
          "manager": {
            "roles": [
              "Manager"
            ]
          },
          "user": {
            "roles": [
              "User"
            ]
          }
        }
      }
    }
  }
}

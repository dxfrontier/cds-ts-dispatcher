{
  "name": "@dxfrontier/cds-ts-dispatcher",
  "version": "6.0.0",
  "description": "The goal of CDS-TS-Dispatcher is to significantly reduce the boilerplate code required to implement TS handlers provided by the SAP CAP framework.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist",
    "./postinstall"
  ],
  "workspaces": [
    "test/sample-project/bookshop",
    "test/sample-project/monorepo_bookshop/services/api",
    "test/sample-project/monorepo_bookshop/services/admin"
  ],
  "scripts": {
    "eslint:message": "echo 'Eslint started...'",
    "eslint": "npx eslint .",
    "eslint:fix": "npx eslint . --fix",
    "prettier:message": "echo 'Prettier started ...'",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write",
    "check": "run-s eslint:message eslint prettier:message prettier",
    "fix": "run-s eslint:message eslint:fix prettier:message prettier:fix",
    "start:bookshop": "npm run start --prefix ./test/sample-project/bookshop",
    "test:newman": "newman run ./test/__tests__/e2e/CDS-TS-Dispatcher.postman_collection.json --environment ./test/__tests__/e2e/environment.json --bail",
    "test:ws:smoke": "node ./test/__tests__/e2e/ws-smoke.js",
    "test:e2e:suite": "run-s test:newman test:ws:smoke",
    "build:entities:integration": "npm run build:entities --prefix ./test/sample-project/bookshop && node -e \"const{execFileSync}=require('child_process');const cli=require.resolve('@cap-js/cds-typer/lib/cli.js',{paths:['./test/sample-project/bookshop']});execFileSync(process.execPath,[cli,'*','--outputDirectory','./@cds-models','--logLevel','SILENT'],{cwd:'./test/sample-project/monorepo_bookshop/services/admin',stdio:'inherit'})\"",
    "test:unit": "npm run build:entities:test --prefix ./test/sample-project/bookshop && jest --selectProjects unit",
    "test:integration": "npm run build:entities:integration && jest --selectProjects integration",
    "test:coverage": "npm run build:entities:integration && jest --coverage",
    "test:e2e": "start-server-and-test start:bookshop http://localhost:4004 test:e2e:suite",
    "test:verifier": "tsx ./test/postinstall/Verifier.ts",
    "test:verifier:monorepo": "tsx ./test/postinstall/MonoRepoVerifier.ts",
    "test:postinstall:docker": "bash ./test/postinstall/docker/run.sh",
    "test": "run-s test:e2e",
    "commit": "commit",
    "prepare": "husky",
    "postinstall": "node ./postinstall/PostInstall.js",
    "documentation:message": "echo 'Started creation of documentation based on TypeDoc ...'",
    "documentation:build": "npx typedoc",
    "documentation:start:server": "http-server ./lib/docs",
    "documentation:open:browser": "open-cli http://127.0.0.1:8080",
    "documentation": "run-p documentation:start:server documentation:open:browser",
    "build:message": "echo 'Build started...'",
    "build:clean": "echo 'Clean dist folder ...' && rm -rf ./dist/",
    "build:clean:postinstall": "echo 'Clean postinstall folder ...' && npx rimraf ./postinstall/PostInstall.js",
    "build:ts": "tsup",
    "build": "run-s build:clean build:clean:postinstall build:message build:ts",
    "typecheck:native": "tsgo --noEmit -p tsconfig.json --moduleResolution bundler"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxfrontier/cds-ts-dispatcher.git"
  },
  "keywords": [
    "CDS-TS-Dispatcher",
    "CDS-TS-Repository",
    "SAP CAP Decorators",
    "SAP CAP TypeScript",
    "Controller-Service-Repository"
  ],
  "author": {
    "name": "Daniel Dragolea",
    "email": "dragolea@yahoo.com"
  },
  "maintainers": [
    {
      "name": "Daniel Dragolea",
      "email": "dragolea@yahoo.com"
    },
    {
      "name": "Sebastian Blessing",
      "email": "sebastian.blessing@abs-gmbh.de"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dxfrontier/cds-ts-dispatcher/issues"
  },
  "homepage": "https://github.com/dxfrontier/cds-ts-dispatcher#readme",
  "peerDependencies": {
    "@sap/cds": "^10"
  },
  "peerDependenciesMeta": {
    "@sap/cds": {
      "optional": false
    }
  },
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.3.1",
    "cross-spawn": "^7.0.6",
    "fast-glob": "^3.3.3",
    "http-status-codes": "^2.3.0",
    "inversify": "^7.11.0",
    "jsonc-parser": "^3.3.1",
    "lodash": "^4.17.21",
    "reflect-metadata": "^0.2.2",
    "string-placeholder": "^1.0.2",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/prompt-cli": "^20.3.1",
    "@commitlint/types": "^20.3.1",
    "@sap/cds": "^10.0.3",
    "@sap/cds-dk": "^10.0.5",
    "@swc/core": "^1.15.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/string-placeholder": "^1.0.3",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^9.39.2",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "newman": "^6.2.1",
    "npm-run-all": "^4.1.5",
    "open-cli": "^8.0.0",
    "picocolors": "^1.1.1",
    "prettier": "3.7.4",
    "rimraf": "^6.1.2",
    "start-server-and-test": "^2.1.3",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "ws": "^8.21.1"
  },
  "lint-staged": {
    "**/*.ts": [
      "npm run eslint:fix",
      "npm run prettier:fix",
      "npm run test:unit --bail --findRelatedTests ./test"
    ]
  }
}
